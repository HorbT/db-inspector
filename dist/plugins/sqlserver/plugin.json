      "tooltip": "数据库登录用户名"
    },
    {
      "name": "password",
      "label": "密码",
      "type": "password",
      "defaultValue": "",
      "required": false,
      "tooltip": "数据库登录密码"
    },
    {
      "name": "database",
      "label": "数据库名",
      "type": "text",
      "defaultValue": "master",
      "required": true,
      "tooltip": "SQL Server数据库名"
