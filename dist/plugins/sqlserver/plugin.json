{
  "id": "sqlserver",
  "name": "SQL Server",
  "description": "SQL Server 数据库巡检",
  "icon": "server",
  "defaultPort": 1433,
  "fields": [
    {
      "name": "host",
      "label": "主机地址",
      "type": "text",
      "defaultValue": "",
      "required": true,
      "tooltip": "SQL Server数据库服务器地址",
      "placeholder": "192.168.1.100"
    },
    {
      "name": "port",
      "label": "端口",
      "type": "number",
      "defaultValue": "1433",
      "required": true,
      "tooltip": "数据库端口，SQL Server默认1433"
