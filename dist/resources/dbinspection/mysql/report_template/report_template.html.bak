    <script>
        // 导航菜单展开/折叠功能
        document.addEventListener('DOMContentLoaded', function() {
            // 导航组点击事件
            const navGroupHeaders = document.querySelectorAll('.nav-group > div.nav-item');
            navGroupHeaders.forEach(header => {
                header.addEventListener('click', function() {
                    const group = this.parentElement;
                    const submenu = group.querySelector('ul');
                    const icon = this.querySelector('.fa-chevron-down');

                    // 切换子菜单显示状态
                    submenu.classList.toggle('hidden');
                    // 旋转图标
                    icon.style.transform = submenu.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
                });
            });

            // 默认展开第一个导航组
            const firstGroup = document.querySelector('.nav-group');
            if (firstGroup) {
                const firstSubmenu = firstGroup.querySelector('ul');
                const firstIcon = firstGroup.querySelector('.fa-chevron-down');
                firstSubmenu.classList.remove('hidden');
                firstIcon.style.transform = 'rotate(180deg)';
            }

            // 导航项点击事件 - 更新激活状态
            const navItems = document.querySelectorAll('.nav-item a, .nav-group > div.nav-item');
            navItems.forEach(item => {
                item.addEventListener('click', function() {
                    // 移除所有激活状态
                    document.querySelectorAll('.nav-item').forEach(navItem => {
                        navItem.classList.remove('active');
                    });

                    // 添加当前项激活状态
                    this.classList.add('active');
                });
            });

            // 移动端导航切换
            const mobileNavToggle = document.getElementById('mobile-nav-toggle');
            const sidebar = document.getElementById('sidebar');

            mobileNavToggle.addEventListener('click', function() {
                sidebar.classList.toggle('hidden');
                sidebar.classList.toggle('fixed');
                sidebar.classList.toggle('inset-0');
                sidebar.classList.toggle('z-40');
                sidebar.classList.toggle('lg:static');
                sidebar.classList.toggle('lg:inset-auto');

                // 切换图标
                const icon = this.querySelector('i');
                if (icon.classList.contains('fa-bars')) {
                    icon.classList.remove('fa-bars');
                    icon.classList.add('fa-times');
                } else {
                    icon.classList.remove('fa-times');
                    icon.classList.add('fa-bars');
                }
            });

            // 滚动时显示内容区块动画
            const observerOptions = {
                root: null,
                rootMargin: '0px',
                threshold: 0.1
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.content-section').forEach(section => {
                observer.observe(section);
            });

            // 1. 获取表格数据（div-id为1-2-1-1中的表格）
            const tableContainer0 = document.getElementById('1-2-1-1');
            const table0 = tableContainer0.querySelector('table');

            // 收集标签（第一列：table_schema）和数据（第二列：db_size）
            const labels0 = [];
            const data0 = [];

            // 从第二行开始读取数据（第一行是表头）
            for (let i = 1; i < table0.rows.length; i++) {
                const row = table0.rows[i];
                // 第一列作为标签（c）
                labels0.push(row.cells[0].textContent.trim());
                // 第二列作为数据（db_size）
                data0.push(parseFloat(row.cells[1].textContent.trim()));
            }

            // 2. 生成环形图
            const ctx0 = document.getElementById('db-size-chart').getContext('2d');

            // 生成多色渐变（适应多个schema的情况）
            const backgroundColors0 = [
                '#36CFC9',  // 青绿色
                '#FAAD14',  // 橙黄色
                '#F5222D',  // 红色
                '#722ED1',  // 深紫色
                '#FA541C',  // 橙红色
                '#1890FF',  // 亮蓝色
                '#52C41A',  // 绿色
                '#0FC6C2',  // 深青色
                '#E02020',  // 深红色
                '#3B82F6'   // 靛蓝色
            ];
            new Chart(ctx0, {
                type: 'doughnut',
                data: {
                    labels: labels0,  // 使用查询到的第一列（db_size）作为标签
                    datasets: [{
                        data: data0,     // 使用查询到的第二列（db_size）作为数据
                        backgroundColor: backgroundColors0.slice(0, labels0.length),  // 自动适配数据量的颜色
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'left',  // 左侧显示图例（避免标签过多时重叠）
                            labels: {
                                boxWidth: 12,
                                padding: 15
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `${context.label}: ${context.raw} GB`;
                                }
                            }
                        }
                    },
                    cutout: '70%'
                }
            });

            // 1. 获取表格数据（div-id为1-2-1-2中的表格）
            const tableContainer1 = document.getElementById('1-2-1-2');
            const table1 = tableContainer1.querySelector('table');

            // 收集标签（第一列：table_name）和数据（第二列：table_size）
            const labels1 = [];
            const data1 = [];

            // 从第二行开始读取数据（第一行是表头）
            for (let i = 1; i < table1.rows.length; i++) {
                const row = table1.rows[i];
                // 第一列作为标签（owner）
                labels1.push(row.cells[0].textContent.trim());
                // 第二列作为数据（seg_size）
                data1.push(parseFloat(row.cells[1].textContent.trim()));
            }

            // 2. 生成环形图
            const ctx1 = document.getElementById('table-size-chart').getContext('2d');

            // 生成多色渐变（适应多个schema的情况）
            const backgroundColors1 = [
                '#36CFC9',  // 青绿色
                '#FAAD14',  // 橙黄色
                '#F5222D',  // 红色
                '#722ED1',  // 深紫色
                '#FA541C',  // 橙红色
                '#1890FF',  // 亮蓝色
                '#52C41A',  // 绿色
                '#0FC6C2',  // 深青色
                '#E02020',  // 深红色
                '#3B82F6'   // 靛蓝色
            ];
            new Chart(ctx1, {
                type: 'doughnut',
                data: {
                    labels: labels1,  // 使用查询到的第一列（owner）作为标签
                    datasets: [{
                        data: data1,     // 使用查询到的第二列（seg_size）作为数据
                        backgroundColor: backgroundColors1.slice(0, labels1.length),  // 自动适配数据量的颜色
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'right',  // 右侧显示图例（避免标签过多时重叠）
                            labels: {
                                boxWidth: 12,
                                padding: 15
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `${context.label}: ${context.raw} GB`;
                                }
                            }
                        }
                    },
                    cutout: '70%'
                }
            });

            // 更新当前时间
            const now = new Date();
            const formattedTime = now.toLocaleString('zh-CN', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });
            // document.getElementById('inspection-time').textContent = formattedTime;
        });
    </script>
</body>
</html>
