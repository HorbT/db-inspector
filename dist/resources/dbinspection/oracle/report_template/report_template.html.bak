                                <li>
                                    <a href="#section-1-4" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">ASM磁盘监控</a>
                                    <ul class="pl-6 mt-1 space-y-1">
                                        <li><a href="#section-1-4-1" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">ASM磁盘使用情况</a></li>
                                        <li><a href="#section-1-4-2" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">ASM磁盘组使用情况</a></li>
                                        <li><a href="#section-1-4-3" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">ASM实例</a></li>
                                    </ul>
                                </li>
                                <li>
                                    <a href="#section-1-5" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">JOB情况</a>
                                    <ul class="pl-6 mt-1 space-y-1">
                                        <li><a href="#section-1-5-1" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">作业运行状况</a></li>
                                        <li><a href="#section-1-5-2" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">数据库job报错信息</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </li>

                        <!-- （二）巡检服务明细 -->
                        <li class="nav-group">
                            <div class="nav-item flex items-center py-2 px-3 rounded-md hover:bg-neutral-light cursor-pointer transition-colors duration-200" data-target="section-2">
                                <i class="fa fa-list-alt w-5 text-center mr-3 text-primary"></i>
                                <span>（二）巡检服务明细</span>
                                <i class="fa fa-chevron-down ml-auto text-xs transition-transform duration-300"></i>
                            </div>
                            <ul class="pl-10 mt-1 mb-2 space-y-1 hidden">
                                <li>
                                    <a href="#section-2-1" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">RMAN信息</a>
                                    <ul class="pl-6 mt-1 space-y-1">
                                        <li><a href="#section-2-1-1" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">RMAN备份状况</a></li>
                                        <li><a href="#section-2-1-2" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">RMAN所有备份</a></li>
                                        <li><a href="#section-2-1-3" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">控制文件备份</a></li>
                                        <li><a href="#section-2-1-4" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">spfile文件备份</a></li>
                                        <li><a href="#section-2-1-5" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">RMAN归档文件备份</a></li>
                                    </ul>
                                </li>
                                <li>
                                    <a href="#section-2-2" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">归档信息</a>
                                    <ul class="pl-6 mt-1 space-y-1">
                                        <li><a href="#section-2-2-1" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">归档日志生成情况</a></li>
                                        <li><a href="#section-2-2-2" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">近7天日志切换频率</a></li>
                                        <li><a href="#section-2-2-3" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">每天日志切换的量</a></li>
                                    </ul>
                                </li>
                                <!-- 其他子项省略，实际使用时需要完整列出 -->
                                <li>
                                    <a href="#section-2-3" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">SGA信息</a>
                                    <ul class="pl-6 mt-1 space-y-1">
                                        <li><a href="#section-2-3-1" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">SGA使用情况</a></li>
                                        <li><a href="#section-2-3-2" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">SGA配置信息</a></li>
