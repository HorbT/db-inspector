            </button>

            <!-- 右侧内容区域 -->
            <main class="flex-1 overflow-y-auto main-content bg-gray-50 p-4 lg:p-8" id="content">
                <!-- 头部信息 -->
                <header class="bg-primary text-white shadow-lg z-10">
                    <div class="container mx-auto px-4 py-6 md:py-8">
                        <div class="flex flex-col md:flex-row md:items-center justify-between">
                            <div>
                                <h1 class="text-[clamp(1.5rem,3vw,2.5rem)] font-bold text-shadow">{{description}}数据库巡检报告</h1>
                                <p class="mt-2 opacity-90">全面数据库性能与健康状况分析</p>
                            </div>
                            <div class="mt-4 md:mt-0 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                                <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-2">
                                    <p class="text-xs opacity-80">巡检人</p>
                                    <p class="font-medium" id="dba-name">Horb.Tao</p>
                                </div>
                                <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-2">
                                    <p class="text-xs opacity-80">巡检时间</p>
                                    <p class="font-medium" id="inspection-time">{{generated_time}}</p>
                                </div>
                                <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-2 col-span-1 md:col-span-1">
                                    <p class="text-xs opacity-80">数据库类型</p>
                                    <p class="font-medium" id="db-name">OracleDB</p>
                                </div>
                                <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-2 col-span-1 md:col-span-1">
                                    <p class="text-xs opacity-80">软件版本</p>
                                    <p class="font-medium" id="db-version">v1.0</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>
                <!-- （一）巡检服务概要 -->
                <section id="section-1" class="mb-12 content-section visible">
                    <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
                        <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
                            <i class="fa fa-tachometer text-primary mr-3"></i>
                            （一）巡检服务概要
                        </h2>
                        <p class="text-gray-600">本部分包含数据库的总体概况、参数配置、表空间情况、ASM 磁盘监控和JOB运行状况等关键信息，帮助您快速了解数据库的整体状态。</p>
                    </div>

                    <!-- 数据库总体概况 -->
                    <div id="section-1-1" class="bg-white rounded-xl shadow-sm p-6 mb-8 content-section">
                        <h3 class="text-xl font-semibold text-gray-800 mb-4 border-l-4 border-primary pl-3">数据库总体概况</h3>

                        <!-- 数据库基本信息 -->
                        <div id="section-1-1-1" class="mb-8">
                            <h4 class="text-lg font-medium text-gray-700 mb-3">数据库基本信息</h4>
                            <div class="bg-gray-50 rounded-lg p-4 font-mono text-sm overflow-x-auto overflow-y-auto max-h-[400px] width-auto">
                                { result_0 }
                            </div>
                            <div class="bg-gray-50 rounded-lg p-4 font-mono text-sm overflow-x-auto overflow-y-auto max-h-[400px] width-auto">
                                { result_1 }
                            </div>
                        </div>
                        <!-- 数据库基本信息 -->
                        <div id="section-1-1-2" class="mb-8">
                            <h4 class="text-lg font-medium text-gray-700 mb-3">需要关注的问题</h4>
                            <div class="bg-gray-50 rounded-lg p-4 font-mono text-sm overflow-x-auto overflow-y-auto max-h-[400px] width-auto">
                                { result_2 }
                            </div>
                        </div>
                        <!-- 数据库大小 -->
