                                    <ul class="pl-6 mt-1 space-y-1">
                                        <li><a href="#section-3-3-1" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">审计参数配置</a></li>
                                        <li><a href="#section-3-3-2" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">DB中所有审计记录</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </li>

                        <!-- （四）数据库对象 -->
                        <li class="nav-group">
                            <div class="nav-item flex items-center py-2 px-3 rounded-md hover:bg-neutral-light cursor-pointer transition-colors duration-200" data-target="section-4">
                                <i class="fa fa-database w-5 text-center mr-3 text-primary"></i>
                                <span>（四）数据库对象</span>
                                <i class="fa fa-chevron-down ml-auto text-xs transition-transform duration-300"></i>
                            </div>
                            <ul class="pl-10 mt-1 mb-2 space-y-1 hidden">
                                <li>
                                    <a href="#section-4-1" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">段情况</a>
                                    <ul class="pl-6 mt-1 space-y-1">
