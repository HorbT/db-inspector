    </div>

    <!-- 引入Chart.js（本地优先） -->
    <script src="../report_template/libs/chart.umd.min.js"
            onerror="this.remove(); const cdnScript = document.createElement('script'); cdnScript.src='https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js'; document.head.appendChild(cdnScript);">
    </script>
    <script>
        // 导航菜单展开/折叠功能
        document.addEventListener('DOMContentLoaded', function() {
            // 导航组点击事件
            const navGroupHeaders = document.querySelectorAll('.nav-group > div.nav-item');
            navGroupHeaders.forEach(header => {
                header.addEventListener('click', function() {
                    const group = this.parentElement;
                    const submenu = group.querySelector('ul');
                    const icon = this.querySelector('.fa-chevron-down');

                    // 切换子菜单显示状态
                    submenu.classList.toggle('hidden');
                    // 旋转图标
                    icon.style.transform = submenu.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
                });
            });

            // 默认展开第一个导航组
            const firstGroup = document.querySelector('.nav-group');
            if (firstGroup) {
                const firstSubmenu = firstGroup.querySelector('ul');
                const firstIcon = firstGroup.querySelector('.fa-chevron-down');
                firstSubmenu.classList.remove('hidden');
                firstIcon.style.transform = 'rotate(180deg)';
            }

            // 导航项点击事件 - 更新激活状态
            const navItems = document.querySelectorAll('.nav-item a, .nav-group > div.nav-item');
            navItems.forEach(item => {
                item.addEventListener('click', function() {
                    // 移除所有激活状态
                    document.querySelectorAll('.nav-item').forEach(navItem => {
                        navItem.classList.remove('active');
                    });

                    // 添加当前项激活状态
                    this.classList.add('active');
                });
            });

            // 移动端导航切换
            const mobileNavToggle = document.getElementById('mobile-nav-toggle');
            const sidebar = document.getElementById('sidebar');

            mobileNavToggle.addEventListener('click', function() {
                sidebar.classList.toggle('hidden');
                sidebar.classList.toggle('fixed');
                sidebar.classList.toggle('inset-0');
                sidebar.classList.toggle('z-40');
                sidebar.classList.toggle('lg:static');
                sidebar.classList.toggle('lg:inset-auto');

                // 切换图标
                const icon = this.querySelector('i');
                if (icon.classList.contains('fa-bars')) {
                    icon.classList.remove('fa-bars');
                    icon.classList.add('fa-times');
                } else {
                    icon.classList.remove('fa-times');
                    icon.classList.add('fa-bars');
                }
            });

            // 滚动时显示内容区块动画
            const observerOptions = {
                root: null,
                rootMargin: '0px',
                threshold: 0.1
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.content-section').forEach(section => {
                observer.observe(section);
            });

            // 1. 收集TiKV节点数据（需确保表格所在div的ID与实际一致）
            const tableContainer = document.getElementById('1-3-1-1');
            const table = tableContainer.querySelector('table');
            const nodes = []; // 存储每个节点的完整信息（用于Tooltip）
            
            // 【修复点1】先读取表格数据填充nodes，再提取标签和数据
            // 从第二行开始读取数据（第一行是表头）
            for (let i = 1; i < table.rows.length; i++) {
              const row = table.rows[i];
              // 【修复点2】处理GiB单位：提取数字 + 转TiB（1 TiB = 1024 GiB）
              const capacityGiB = parseFloat(row.cells[2].textContent.replace('GiB', '').trim());
              const availableGiB = parseFloat(row.cells[3].textContent.replace('GiB', '').trim());
              
              nodes.push({
                address: row.cells[0].textContent.trim(),
                state: row.cells[1].textContent.trim(),
                capacity: capacityGiB / 1024, // GiB转TiB，统一单位
                available: availableGiB / 1024, // GiB转TiB
                leaderCount: parseInt(row.cells[4].textContent.trim()),
                uptime: row.cells[5].textContent.trim()
              });
            }
            
            // 【修复点1】现在nodes有数据了，再提取标签和数据系列
            const labels = nodes.map(node => node.address); // X轴：节点地址
            const capacityData = nodes.map(node => node.capacity); // 总容量（TiB）
            const availableData = nodes.map(node => node.available); // 可用容量（TiB）
            const leaderData = nodes.map(node => node.leaderCount); // Leader数量
            
            // 2. 生成双Y轴分组柱状图
            const ctx = document.getElementById('store-info-chart').getContext('2d');
            new Chart(ctx, {
              type: 'bar', // 柱状图类型
              data: {
                labels: labels,
                datasets: [
                  // 数据集1：总容量
                  {
                    label: '总容量（TiB）',
                    data: capacityData,
                    backgroundColor: '#36CFC9', // 青绿色
                    yAxisID: 'y' // 绑定到左侧Y轴
                  },
                  // 数据集2：可用容量
                  {
                    label: '可用容量（TiB）',
                    data: availableData,
                    backgroundColor: '#1890FF', // 亮蓝色
                    yAxisID: 'y' // 绑定到左侧Y轴
                  },
                  // 数据集3：Leader数量
                  {
                    label: 'Leader数量',
                    data: leaderData,
                    backgroundColor: '#FAAD14', // 橙黄色
                    yAxisID: 'y1' // 绑定到右侧Y轴
                  }
                ]
              },
              options: {
                responsive: true,
                plugins: {
                  legend: {
                    position: 'left', // 图例在左侧
                    labels: {
                      boxWidth: 12,
                      padding: 15
                    }
                  },
                  tooltip: {
                    // 自定义Tooltip：显示节点状态、运行时长
                    callbacks: {
                      label: function(context) {
                        const node = nodes[context.dataIndex];
                        let label = context.dataset.label || '';
                        // 区分不同数据集的显示内容
                        if (label.includes('容量')) {
                          // 保留3位小数，显示更精准的TiB数值
                          label += `: ${context.raw.toFixed(3)} TiB`;
                        } else {
                          label += `: ${context.raw}`;
                        }
                        // 补充状态和运行时长
                        label += `\n状态: ${node.state}\n运行时长: ${node.uptime}`;
                        return label;
                      }
                    }
                  }
                },
                scales: {
                  // 左侧Y轴：存储容量（TiB）
                  y: {
                    type: 'linear',
                    display: true,
                    position: 'left',
                    title: {
                      display: true,
                      text: '存储容量（TiB）'
                    }
                  },
                  // 右侧Y轴：Leader数量
                  y1: {
                    type: 'linear',
                    display: true,
                    position: 'right',
                    title: {
                      display: true,
                      text: 'Leader数量'
                    },
                    // 避免左右Y轴重叠
                    grid: {
                      drawOnChartArea: false
                    }
                  }
                }
              }
            });

            // 1. 获取表格数据（div-id为1-3-1-2中的表格）
            const tableContainer1 = document.getElementById('1-3-1-2');
            const table1 = tableContainer1.querySelector('table');

            // 收集标签（第一列：db_name）和数据（第二列：counts）
            const labels1 = [];
            const data1 = [];

            // 从第二行开始读取数据（第一行是表头）
            for (let i = 1; i < table1.rows.length; i++) {
                const row = table1.rows[i];
                // 第一列作为标签（db_name）
                labels1.push(row.cells[0].textContent.trim());
                // 第二列作为数据（counts）
                data1.push(parseFloat(row.cells[1].textContent.trim()));
            }

            // 新增：自动生成颜色的函数（根据数据条数动态生成差异化颜色）
            function generateDynamicColors(dataLength) {
                const colors = [];
                const hueStep = 360 / dataLength; // 按数据条数均分色相环（0-360°）
                for (let i = 0; i < dataLength; i++) {
                    // 使用HSL颜色：色相循环、饱和度70%（鲜艳）、亮度50%（适中）
                    const hue = i * hueStep;
                    colors.push(`hsl(${hue}, 70%, 50%)`);
                }
                return colors;
            }

            // 2. 生成环形图
            const ctx1 = document.getElementById('object-count-chart').getContext('2d');

            // 替换为自动生成的颜色（根据labels1的长度动态生成）
            const backgroundColors1 = generateDynamicColors(labels1.length);

            new Chart(ctx1, {
                type: 'doughnut',
                data: {
                    labels: labels1,
                    datasets: [{
                        data: data1,
                        backgroundColor: backgroundColors1, // 直接用动态生成的颜色（自动适配数据量）
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                boxWidth: 12,
                                padding: 15
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    // 注意：你的数据是counts，这里建议把"GB"改成"个"更准确
                                    return `${context.label}: ${context.raw} 个对象`;
                                }
                            }
                        }
                    },
                    cutout: '70%'
                }
            });

            // 更新当前时间
            const now = new Date();
            const formattedTime = now.toLocaleString('zh-CN', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });
            // document.getElementById('inspection-time').textContent = formattedTime;
        });
    </script>
</body>
</html>
