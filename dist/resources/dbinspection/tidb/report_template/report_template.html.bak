                            <ul class="pl-10 mt-1 mb-2 space-y-1 hidden">
                                <li>
                                    <a href="#section-7-1" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">备份与还原进度</a>
                                    <ul class="pl-6 mt-1 space-y-1">
                                        <li><a href="#section-7-1-1" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">备份进度</a></li>
                                        <li><a href="#section-7-1-2" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">还原进度</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </li>

                        <!-- （八）其它 -->
                        <li class="nav-group">
                            <div class="nav-item flex items-center py-2 px-3 rounded-md hover:bg-neutral-light cursor-pointer transition-colors duration-200" data-target="section-8">
                                <i class="fa fa-sticky-note w-5 text-center mr-3 text-primary"></i>
                                <span>（八）其它</span>
                                <i class="fa fa-chevron-down ml-auto text-xs transition-transform duration-300"></i>
                            </div>
                            <ul class="pl-10 mt-1 mb-2 space-y-1 hidden">
                                <li>
                                    <a href="#section-8-1" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">表属性信息</a>
                                    <ul class="pl-6 mt-1 space-y-1">
                                        <li><a href="#section-8-1-1" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">无主键或唯一键的表</a></li>
                                        <li><a href="#section-8-1-2" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">使用TiFlash的表</a></li>
                                    </ul>
                                </li>
                                <li>
                                    <a href="#section-8-2" class="nav-item flex items-center py-1.5 px-3 rounded-md hover:bg-neutral-light text-sm cursor-pointer transition-colors duration-200">特殊标识使用</a>
