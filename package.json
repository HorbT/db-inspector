{
  "name": "db-inspector",
  "version": "1.0.0",
  "description": "统一数据库巡检平台 - 支持MySQL/Oracle/SQLServer/TiDB",
  "main": "dist/main/main/index.js",
  "author": "DB Inspector Team",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.node.json && tsc-alias -p tsconfig.node.json && electron .",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsc -p tsconfig.node.json && tsc-alias -p tsconfig.node.json",
    "build:renderer": "vite build",
    "copy-resources": "node scripts/copy-resources.js",
    "package": "npm run build && npm run copy-resources && electron-builder",
    "package:win": "npm run build && npm run copy-resources && electron-builder --win"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "electron-store": "^8.2.0",
    "framer-motion": "^11.18.2",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "lucide-react": "^0.400.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss": "^3.4.6",
    "tailwindcss-animate": "^1.0.7",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "zustand": "^4.5.4"
  }
}
